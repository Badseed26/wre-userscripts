{
  "title": "WRE Panel",
  "browser": "chrome",
  "groups": [
    {
      "name": "Work",
      "buttons": [
        { "id": "dashboard", "label": "WRE Dashboard", "sub": "Follow ups and tracker", "type": "url", "target": "https://claude.ai/artifact/Ah1oAv4j9heVqWdqPRNYAx" },
        { "id": "aroflo", "label": "AroFlo", "sub": "Home", "type": "url", "target": "https://office.aroflo.com/ims/Site/Home/index.cfm" },
        { "id": "outlook", "label": "Outlook", "sub": "Shared inbox", "type": "url", "target": "https://outlook.cloud.microsoft/mail/" },
        { "id": "filer", "label": "Inbox Filer tabs", "sub": "Opens both, pin them", "type": "urls", "targets": ["https://outlook.cloud.microsoft/mail/#wre-filer", "https://office.aroflo.com/ims/Site/Home/index.cfm#wre-filer"] },
        { "id": "todoist", "label": "Todoist", "sub": "WRE follow ups", "type": "url", "target": "https://app.todoist.com/app/" },
        { "id": "tradies", "label": "Tradies Web", "sub": "Ambrose reports", "type": "url", "target": "https://tradies.ambrosebuilding.com.au/" },
        { "id": "ambroseadmin", "label": "Ambrose admin", "sub": "POs", "type": "url", "target": "https://tradiesadmin.ambroseconstruct.com.au/" }
      ]
    },
    {
      "name": "Claude",
      "buttons": [
        { "id": "c-daily", "label": "Daily check", "sub": "Notes, photos, timesheets", "type": "claude", "prompt": "Run my AroFlo daily check" },
        { "id": "c-inbox", "label": "Inbox check", "sub": "Pull first on the dashboard", "type": "claude", "prompt": "Run my daily inbox check" },
        { "id": "c-week", "label": "Week scope check", "sub": "Next week's tasks", "type": "claude", "prompt": "Run my AroFlo week ahead scope check" },
        { "id": "c-trades", "label": "Trade attendance", "sub": "2 working days ahead", "type": "claude", "prompt": "Run the trade attendance check" },
        { "id": "c-esa", "label": "Energex ESA check", "sub": "Safety advice inbox", "type": "claude", "prompt": "Run the Energex safety advice check" },
        { "id": "c-tidy", "label": "Job tracker tidy", "sub": "Weekly", "type": "claude", "prompt": "Run the weekly job tracker tidy" },
        { "id": "c-timesheet", "label": "Do my timesheet", "sub": "After hours time", "type": "claude", "prompt": "Do my timesheet" },
        { "id": "c-lisa", "label": "Lisa handoff", "sub": "Flag what Lisa can do", "type": "claude", "prompt": "Run the Lisa handoff check" }
      ]
    },
    {
      "name": "Clipboard Brain",
      "buttons": [
        { "id": "cb-start", "label": "Start Clipboard Brain", "sub": "Run this first", "type": "ahk", "target": "%DOCUMENTS%\\WRE\\wre-clipboard-brain.ahk" },
        { "id": "cb-boys", "label": "PO lines for the boys", "sub": "Select text on PC first", "type": "keys", "keys": "ctrl+alt+1" },
        { "id": "cb-cust", "label": "Customer text", "sub": "Select text on PC first", "type": "keys", "keys": "ctrl+alt+2" },
        { "id": "cb-promise", "label": "Promise check", "sub": "Select text on PC first", "type": "keys", "keys": "ctrl+alt+3" }
      ]
    },
    {
      "name": "Gaming",
      "buttons": [
        { "id": "sotf", "label": "SOTF Nucleus Pause", "sub": "AHK", "type": "ahk", "target": "%DOCUMENTS%\\SOTF_Nucleus_Pause.ahk" }
      ]
    },
    {
      "name": "PC",
      "buttons": [
        { "id": "lock", "label": "Lock PC", "sub": "", "type": "lock", "confirm": true },
        { "id": "update", "label": "Check for updates", "sub": "Runs every 15 min anyway", "type": "update" },
        { "id": "repo", "label": "Scripts repo", "sub": "wre-userscripts", "type": "url", "target": "https://github.com/Badseed26/wre-userscripts" },
        { "id": "panelfolder", "label": "Panel folder", "sub": "Edit buttons.json", "type": "file", "target": "." }
      ]
    }
  ]
}
